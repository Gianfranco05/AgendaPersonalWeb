# Variables de entorno para PRODUCCIÓN (docker-compose.prod.yml).
# Copiar a `.env` en la raíz del repo y completar:  cp .env.prod.example .env
#
# docker compose lee automáticamente el archivo `.env` de la raíz.

# ── Requerido ────────────────────────────────────────────────────────────────
# Clave para firmar los JWT. DEBE tener 32+ caracteres y NO ser un valor por defecto.
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contraseña de la base Postgres (servicio `db` interno, no expuesto fuera del stack).
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# POSTGRES_USER=vida_personal
# POSTGRES_DB=vida_personal

# Orígenes permitidos para CORS (coma-separados). En prod, el dominio del frontend.
# Con el stack por defecto (nginx sirve todo desde el mismo origen) alcanza con el dominio público.
ALLOWED_ORIGINS=http://localhost

# ── Email transaccional (Resend) ─────────────────────────────────────────────
# Sin RESEND_API_KEY los mails NO se envían: se loguean. La verificación de email
# y el reset de contraseña quedan inutilizables en la práctica.
# Sacá la key de https://resend.com/api-keys y verificá tu dominio antes.
RESEND_API_KEY=
# Remitente: el dominio tiene que estar verificado en Resend.
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NAME=Can_cen
# Base pública usada para armar los links de los mails.
PUBLIC_BASE_URL=https://vida.tudominio.com

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# Compra unica por plantilla (no hay suscripcion/plan Pro). Vacío = billing
# deshabilitado: las 7 plantillas de pago quedan sin precio cargado y la
# tienda las muestra como "Próximamente" (no se bloquean features base).
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook (Dashboard > Developers > Webhooks).
# Sin esto el webhook devuelve 503 y las compras nunca se acreditan.
STRIPE_WEBHOOK_SECRET=
# ID de precio (Dashboard > Products, formato price_xxx) de cada plantilla.
# Dejar vacía la que no se quiera vender todavía.
STRIPE_PRICE_ID_MODULE_STUDY=
STRIPE_PRICE_ID_MODULE_LIBRARY=
STRIPE_PRICE_ID_MODULE_MEDIA=
STRIPE_PRICE_ID_MODULE_WORK=
STRIPE_PRICE_ID_MODULE_TRAVEL=
STRIPE_PRICE_ID_MODULE_VEHICLE=
STRIPE_PRICE_ID_MODULE_PROJECTS=
# Opcionales: si quedan vacíos se derivan de PUBLIC_BASE_URL.
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

# ── TLS (solo si usás docker-compose.prod.tls.yml) ───────────────────────────
# Dominio público con certificado Let's Encrypt en /etc/letsencrypt/live/$DOMAIN/
DOMAIN=vida.tudominio.com

# ── Opcional: notificaciones Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
