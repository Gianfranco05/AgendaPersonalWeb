# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
*.egg-info/
dist/
build/

# Variables de entorno. `.env` solo cubre ese nombre exacto: sin `.env.*` un
# `.env.local` o `.env.prod` se subiria con las claves adentro.
.env
.env.*
!.env.example
!.env.*.example

# Bases de datos locales (contienen los datos reales de los usuarios)
*.db
*.sqlite
*.sqlite3
# Copias manuales de la base de desarrollo: tienen emails y hashes de contraseñas.
*.db.bak*
*.db-journal
*.db-wal
*.db-shm
# Cache de compilacion de TypeScript.
*.tsbuildinfo

# Archivos subidos por usuarios (datos personales)
uploads/

# Node
node_modules/
dist/
coverage/

# Test / debug artifacts
cookies.txt

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Configuracion local de Claude Code (permisos, comandos, skills): es del
# entorno de trabajo, no del proyecto. Queda en el disco, fuera del repo.
.claude/

# OS
.DS_Store
Thumbs.db

# Infra config (contains network credentials)
infra_config.yaml

# MCP config (contains API keys)
.mcp.json
