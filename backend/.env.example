# Database
DATABASE_URL=sqlite+aiosqlite:///./vida_personal.db
# DATABASE_URL=postgresql+asyncpg://vida_user:vida_pass@localhost:5432/vida_personal

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=vida_token

# App
# ENVIRONMENT=production activa validaciones estrictas (SECRET_KEY fuerte, DEBUG=false, HSTS)
ENVIRONMENT=development
DEBUG=true
APP_NAME=Vida Personal
APP_VERSION=1.0.0

# CORS — incluir el origen del frontend (Vite dev: 5173)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting en endpoints de auth
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=300

# Content-Security-Policy para respuestas HTML (vacío = deshabilitado)
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Google Calendar (opcional — dejar vacío para deshabilitar)
# Crear credenciales en: https://console.cloud.google.com/
# Tipo de app: "Aplicación web" — agregar URI de redireccionamiento: http://localhost:8000/ajustes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/ajustes/google/callback

# Login con Google (mismo Client ID/Secret que arriba — sumar esta URL también
# a "Authorized redirect URIs" en Google Cloud Console).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/api/google/callback

# A donde redirige el callback de Google tras conectar (vacío = ruta relativa, correcto en prod).
# En dev local (frontend en :5173, backend en :8000) hay que setearlo así:
FRONTEND_URL=http://localhost:5173

# Billing / Stripe (opcional — vacío = todos quedan en plan free, checkout/portal devuelven 503)
# Crear en: https://dashboard.stripe.com/ (Products → Add product → Add price)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# Opcionales: plan Pro anual y Elite (pago único/lifetime). Vacíos = esos tiers
# no están disponibles (el checkout responde 400 en vez de romper).
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_ELITE=
# A donde vuelve el usuario tras pagar o salir del portal (vacío = PUBLIC_BASE_URL/ajustes).
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

# Infra (Dream Machine + LEDs)
INFRA_CONFIG_PATH=infra_config.yaml
SSH_KEY_PATH=
LED_API_TOKEN=
