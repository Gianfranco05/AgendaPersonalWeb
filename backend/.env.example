# Database
DATABASE_URL=sqlite+aiosqlite:///./vida_personal.db
# DATABASE_URL=postgresql+asyncpg://vida_user:vida_pass@localhost:5432/vida_personal

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=vida_token

# App
DEBUG=true
APP_NAME=Vida Personal
APP_VERSION=1.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Google Calendar (opcional — dejar vacío para deshabilitar)
# Crear credenciales en: https://console.cloud.google.com/
# Tipo de app: "Aplicación web" — agregar URI de redireccionamiento: http://localhost:8000/ajustes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/ajustes/google/callback
