# Database
DATABASE_URL=sqlite+aiosqlite:///./vida_personal.db
# DATABASE_URL=postgresql+asyncpg://vida_user:vida_pass@localhost:5432/vida_personal

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=vida_token

# Refresh token: vida larga, revocable, rotado en cada uso.
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=vida_refresh

# App
# ENVIRONMENT=production activa validaciones estrictas (SECRET_KEY fuerte, DEBUG=false, HSTS)
ENVIRONMENT=development
DEBUG=true
APP_NAME=Can_cen
APP_VERSION=1.0.0

# Version de Terminos/Privacidad vigente (ver frontend/src/pages/Legal/).
# Subir este numero obliga a TODOS los usuarios a re-aceptar la proxima vez
# que abran la app, incluidos los que ya habian aceptado una version anterior.
CURRENT_TERMS_VERSION=1.1

# CORS — incluir el origen del frontend (Vite dev: 5173)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting en endpoints de auth
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=300

# Vacío = limiter en memoria (alcanza con una sola instancia de backend). Con
# más de una instancia hace falta Redis, si no, cada proceso cuenta por
# separado y el límite efectivo se multiplica por la cantidad de réplicas.
REDIS_URL=

# Content-Security-Policy para respuestas HTML (vacío = deshabilitado)
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# Token para GET /metrics (opcional, recomendado en prod expuesto a internet).
# Configurá Prometheus con `authorization: credentials: <token>` en el scrape config.
METRICS_TOKEN=

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Límite global de tamaño de body para cualquier request (bytes, default 1 MiB).
MAX_REQUEST_BODY_SIZE=1048576

# Email transaccional (Resend). Sin API key los mails de verificación y reset
# de contraseña se loguean en vez de enviarse (sirve para dev, NO para prod —
# ver guía de setup). Crear cuenta y API key en: https://resend.com/
RESEND_API_KEY=
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=Can_cen
# Base pública para armar los links de los mails (verificación, reset de
# contraseña). En dev con el frontend en :5173, dejar el valor de abajo.
PUBLIC_BASE_URL=http://localhost:5173
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Google Calendar (opcional — dejar vacío para deshabilitar)
# Crear credenciales en: https://console.cloud.google.com/
# Tipo de app: "Aplicación web" — agregar URI de redireccionamiento: http://localhost:8000/ajustes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/ajustes/google/callback

# Login con Google (mismo Client ID/Secret que arriba — sumar esta URL también
# a "Authorized redirect URIs" en Google Cloud Console).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/api/google/callback

# A donde redirige el callback de Google tras conectar (vacío = ruta relativa, correcto en prod).
# En dev local (frontend en :5173, backend en :8000) hay que setearlo así:
FRONTEND_URL=http://localhost:5173

# Proveedor de pago de la tienda: "mercadopago" (default) o "stripe".
# Stripe no acepta cuentas de Argentina.
BILLING_PROVIDER=mercadopago

# Billing / Mercado Pago Checkout Pro (opcional — sin access token la tienda
# queda deshabilitada y el checkout devuelve 503). Credenciales en:
# https://www.mercadopago.com.ar/developers/panel/app (usar las de prueba en dev).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (panel > Webhooks). Para probar en local hace falta
# exponer el backend (p. ej. ngrok) y apuntar PUBLIC_BASE_URL a esa URL.
MERCADOPAGO_WEBHOOK_SECRET=
# Moneda de los precios (código ISO).
BILLING_CURRENCY=ARS
# Precio por plantilla en CENTAVOS (299900 = $2.999,00). Vacío = "Próximamente".
MP_PRICE_MODULE_STUDY=
MP_PRICE_MODULE_LIBRARY=
MP_PRICE_MODULE_MEDIA=
MP_PRICE_MODULE_WORK=
MP_PRICE_MODULE_TRAVEL=
MP_PRICE_MODULE_VEHICLE=
MP_PRICE_MODULE_PROJECTS=

# Billing / Stripe (solo con BILLING_PROVIDER=stripe; vacío = tienda
# deshabilitada, checkout devuelve 503).
# No hay suscripción: cada plantilla se compra una vez (pago único) y queda en
# la cuenta para siempre. Crear en: https://dashboard.stripe.com/
# (Products → Add product → Price → "One time")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Un Price ID por plantilla. Vacío = esa plantilla todavía no se puede comprar
# (aparece en la tienda como "Próximamente" en vez de romper el checkout).
STRIPE_PRICE_ID_MODULE_STUDY=
STRIPE_PRICE_ID_MODULE_LIBRARY=
STRIPE_PRICE_ID_MODULE_MEDIA=
STRIPE_PRICE_ID_MODULE_WORK=
STRIPE_PRICE_ID_MODULE_TRAVEL=
STRIPE_PRICE_ID_MODULE_VEHICLE=
STRIPE_PRICE_ID_MODULE_PROJECTS=
# A donde vuelve el usuario tras pagar (vacío = PUBLIC_BASE_URL/store).
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

# Infra (Dream Machine + LEDs)
INFRA_CONFIG_PATH=infra_config.yaml
SSH_KEY_PATH=
LED_API_TOKEN=
