# URL base del backend. Vacío = mismo origen que el frontend (correcto en
# prod, donde nginx sirve frontend y backend desde el mismo dominio).
# En dev local (backend en :8000, frontend en :5173) hay que setear esto:
VITE_API_URL=http://localhost:8000

# true = usa datos mock en vez de pegarle al backend (útil para desarrollar
# la UI sin backend levantado). false/vacío en cualquier entorno real.
VITE_MOCK_ENABLED=false

# Nombre del entorno, solo para etiquetar eventos en Sentry (development,
# staging, production).
VITE_ENVIRONMENT=development

# DSN de Sentry (opcional). Vacío = Sentry deshabilitado, no se reportan
# errores del frontend. Crear proyecto en: https://sentry.io/
VITE_SENTRY_DSN=

# Porcentaje de requests trazadas por Sentry Performance (0.0 a 1.0).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
